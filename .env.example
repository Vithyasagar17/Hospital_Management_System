# Medora HMS — Phase 7E production observability environment
# Copy this file to .env before running Docker Compose.

# Runtime mode. Production mode enables strict startup validation.
HMS_ENV=development

# PostgreSQL container
POSTGRES_DB=medora_hms
POSTGRES_USER=medora_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_PORT=5432

# Flask / security
# Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
HMS_SECRET_KEY=replace-with-a-long-random-secret
HMS_COOKIE_SECURE=0
HMS_TIMEZONE=Asia/Kolkata

# Run Alembic migrations automatically when the web container starts.
HMS_RUN_MIGRATIONS=1

# Published host port
APP_PORT=8000

# Gunicorn
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60

# Redis / Celery background processing
REDIS_PORT=6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_WORKER_CONCURRENCY=2
CELERY_REMINDER_INTERVAL_SECONDS=300
CELERY_WAITLIST_INTERVAL_SECONDS=60
HMS_BACKGROUND_REMIND_DOCTORS=0
HMS_BACKGROUND_SEND_REMINDER_EMAILS=0

# Logging, health checks, and lightweight metrics
HMS_LOG_FORMAT=json
HMS_LOG_LEVEL=INFO
HMS_LOG_HEALTH_REQUESTS=0
HMS_HEALTH_REQUIRE_REDIS=1
HMS_METRICS_ENABLED=1

# Mail. Keep console for local development.
HMS_MAIL_MODE=console
HMS_SMTP_SERVER=
HMS_SMTP_PORT=587
HMS_SMTP_USERNAME=
HMS_SMTP_PASSWORD=
HMS_SMTP_FROM=
HMS_SMTP_USE_TLS=1
HMS_SMTP_USE_SSL=0

# For a real HTTPS deployment, at minimum use:
# HMS_ENV=production
# HMS_COOKIE_SECURE=1
# HMS_SECRET_KEY=<strong random secret>
# POSTGRES_PASSWORD=<strong database password>
